<?xml version="1.0" encoding="utf-8"?>
<!-- The Web UI and the WebView talk over plain http://127.0.0.1:8765 inside
     the app process.  Android blocks cleartext traffic by default; allow it
     for the loopback addresses only, so every other host stays on the secure
     default.  The proxy's own listeners (wss://) are unaffected. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
